{
  "name": "ns-gh-copilot",
  "main": "./src/main.ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "ns debug android --no-hmr",
    "ios": "ns debug ios --no-hmr",
    "copilot:bridge": "node tools/copilot-bridge.mjs",
    "copilot:start": "npm run copilot:bridge",
    "dev:ios:copilot": "concurrently -k -n copilot,ns \"npm run copilot:start\" \"wait-on tcp:3210 && npm run ios\"",
    "dev:android:copilot": "concurrently -k -n copilot,ns \"npm run copilot:start\" \"wait-on tcp:3210 && npm run android\""
  },
  "dependencies": {
    "@angular/animations": "~21.0.0",
    "@angular/common": "~21.0.0",
    "@angular/compiler": "~21.0.0",
    "@angular/core": "~21.0.0",
    "@angular/forms": "~21.0.0",
    "@angular/platform-browser": "~21.0.0",
    "@angular/platform-browser-dynamic": "~21.0.0",
    "@angular/router": "~21.0.0",
    "@nativescript/angular": "^21.0.0",
    "@nativescript/core": "~9.0.16",
    "@nativescript/input-accessory": "^1.0.2",
    "@nativescript/iqkeyboardmanager": "^3.0.0",
    "@nstudio/nativescript-menu": "^1.0.4",
    "@nstudio/nativescript-shimmer": "^1.0.7",
    "@nstudio/nstreamdown": "~1.0.6",
    "@valor/nativescript-websockets": "^2.0.2",
    "rxjs": "~7.8.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.0.0",
    "@angular/build": "^21.1.2",
    "@angular/compiler-cli": "~21.0.0",
    "@github/copilot-sdk": "^0.1.20",
    "@nativescript/android": "9.0.4",
    "@nativescript/ios": "9.0.3",
    "@nativescript/tailwind": "^2.1.0",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "~5.0.35",
    "@ngtools/webpack": "~21.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "~3.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "wait-on": "^9.0.0",
    "zod": "^3.24.0"
  }
}
